# Supabase Postgres Configuration (Connect with service-role key only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-supabase-service-role-key

# JWT Token Secret for signing device tokens (HS256 - at least 32 characters)
TOKEN_SECRET=replace-with-a-very-long-and-secure-random-token-secret-32-chars-min

# Fingerprint Hash Salt (Secret salt used to hash device fingerprints with SHA-256)
FP_SALT=replace-with-a-secure-random-fingerprint-salt

# Admin Authentication
ADMIN_PASSWORD=admincravory

# Optional Cloudflare Turnstile Secret Key (leave blank or omit to disable bot verification)
TURNSTILE_SECRET=
